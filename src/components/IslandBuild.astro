---
const pieces = [
	{ id: 'stone-block', en: 'Stone block', ko: '돌 블록', ink: '#765e8e', shape: 'm3 8 9-5 9 5-9 5-9-5Zm0 0v8l9 5 9-5V8m-9 5v8m-4-15 9 5' },
	{ id: 'belt', en: 'Belt', ko: '벨트', ink: '#445588', shape: 'M7 7h10a5 5 0 0 1 0 10H7A5 5 0 0 1 7 7Zm1 5h7m-2-2 2 2-2 2' },
	{ id: 'windmill', en: 'Windmill', ko: '풍차', ink: '#8a5447', shape: 'M12 10v11m-3 0h6M12 10 9 3l3-1v8l7-3 1 3h-8l3 7-3 1v-8l-7 3-1-3h8' },
	{ id: 'drill', en: 'Drill', ko: '드릴', ink: '#5b557f', shape: 'M4 4h16v7H4V4Zm4 7 4 10 4-10m-6 3 4 1m-3 2 2 1M8 7h8' },
	{ id: 'sprinkler', en: 'Sprinkler', ko: '스프링클러', ink: '#367389', shape: 'M7 20h10m-5-1V9m-4 1a4 4 0 0 1 8 0M5 7a9 9 0 0 1 4-3m6 0a9 9 0 0 1 4 3M4 12l-1 2m17-2 1 2' },
	{ id: 'ore-hopper', en: 'Ore hopper', ko: '광석 수거함', ink: '#876235', shape: 'M3 5h18v4l-6 6v4H9v-4L3 9V5Zm0 4h18m-9 6v4m-5 2h10' },
];
---
<section
	class="build-picker"
	id="island-build-picker"
	data-build-picker
	aria-labelledby="island-build-title"
	hidden
>
	<header>
		<h2 id="island-build-title" data-build-ko="짓기">Build</h2>
		<button type="button" class="close" data-build-close aria-label="Close build menu" data-build-ko-label="짓기 메뉴 닫기">
			<span aria-hidden="true">×</span>
		</button>
	</header>
	<div class="pieces" role="group" aria-label="Building pieces" data-build-ko-label="지을 물건">
		{pieces.map(({ id, en, ko, ink, shape }, index) => (
			<button type="button" class="piece" data-build-item={id} aria-pressed="false"
				aria-keyshortcuts={String(index + 1)} title={`${index + 1} · ${en}`} data-build-ko-title={`${index + 1} · ${ko}`} style={{ '--tool-ink': ink }}>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={shape} /></svg>
				<span class="name" data-build-ko={ko}>{en}</span>
				<span class="count" data-build-count>0</span>
			</button>
		))}
	</div>
</section>
<div class="build-active" data-build-active role="group" aria-label="Building controls" data-build-ko-label="배치 조작" hidden>
	<span class="selection" data-build-selection></span>
	<button type="button" class="remove" data-build-remove aria-keyshortcuts="Q">
		<kbd aria-hidden="true">Q</kbd><span data-build-ko="회수하기">Take back</span>
	</button>
	<button type="button" class="done" data-build-done aria-keyshortcuts="Escape">
		<kbd aria-hidden="true">Esc</kbd><span data-build-ko="완료">Done</span>
	</button>
</div>
<p class="status" data-build-status role="status"></p>

<style>
	.build-picker, .build-active {
		position: fixed;
		z-index: 27;
		box-sizing: border-box;
		border: 1px solid color-mix(in srgb, var(--edge) 70%, transparent);
		color: var(--ink);
		background: color-mix(in srgb, var(--surface) 96%, transparent);
		box-shadow: 0 4px 0 var(--edge), 0 12px 22px -16px var(--shadow);
		font-family: var(--sans);
	}
	.build-picker {
		top: max(64px, calc(env(safe-area-inset-top) + 48px));
		right: max(clamp(12px, 4vw, 40px), env(safe-area-inset-right));
		width: min(356px, calc(100% - 24px));
		max-height: calc(100dvh - 76px);
		overflow: auto;
		overscroll-behavior: contain;
		padding: 9px 11px 10px;
		border-radius: 15px;
	}
	.build-picker[hidden],
	.build-active[hidden],
	.build-picker [hidden] { display: none !important; }
	.build-picker > header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
	}
	.build-picker h2 {
		margin: 0 0 0 3px;
		font: 900 17px var(--display);
	}
	.build-picker button, .build-active button {
		touch-action: manipulation;
		cursor: pointer;
		color: var(--ink);
	}
	.build-picker button:focus-visible, .build-active button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.close {
		display: grid;
		place-items: center;
		min-width: 36px;
		min-height: 32px;
		padding: 0 5px;
		border: 0;
		border-radius: 8px;
		background: transparent;
		font: 700 22px/1 var(--sans);
	}
	.close:hover { background: var(--bg); }
	.pieces {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 6px;
		margin: 4px 0 0;
	}
	.piece {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-rows: auto auto;
		align-items: center;
		gap: 1px 5px;
		min-width: 0;
		min-height: 55px;
		padding: 5px 7px 6px;
		border: 1px solid var(--edge);
		border-radius: 9px;
		background: var(--bg);
		text-align: left;
		font: 800 12px/1.2 var(--sans);
	}
	.piece svg {
		grid-column: 1;
		grid-row: 1;
		width: 22px;
		height: 22px;
		color: var(--tool-ink);
	}
	.piece .name { grid-column: 1 / -1; grid-row: 2; overflow-wrap: anywhere; }
	.count {
		grid-column: 2;
		grid-row: 1;
		min-width: 1.3em;
		padding: 2px 4px;
		border-radius: 5px;
		background: var(--surface);
		font-variant-numeric: tabular-nums;
		text-align: center;
	}
	.piece:hover:not(:disabled),
	.piece[aria-pressed="true"] { border-color: var(--accent); }
	.piece[aria-pressed="true"] {
		background: var(--btn-bg);
		color: var(--btn-ink);
		box-shadow: inset 0 0 0 1px var(--accent);
	}
	.piece[aria-pressed="true"] svg,
	.piece[aria-pressed="true"] .count { color: var(--ink); }
	.build-picker button:disabled, .build-active button:disabled { cursor: default; opacity: .5; }
	.build-active {
		top: max(68px, calc(env(safe-area-inset-top) + 54px));
		left: max(clamp(12px, 4vw, 40px), env(safe-area-inset-left));
		max-width: min(355px, calc(100% - 24px));
		display: flex;
		align-items: center;
		gap: 4px;
		padding: 4px;
		border-radius: 12px;
	}
	.selection {
		min-width: 0;
		padding: 0 5px 0 7px;
		overflow-wrap: anywhere;
		font: 900 13px/1.25 var(--sans);
		font-variant-numeric: tabular-nums;
	}
	.remove, .done {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 5px;
		min-height: 35px;
		padding: 3px 8px;
		border: 1px solid var(--edge);
		border-radius: 8px;
		background: var(--bg);
		font: 800 12px/1.2 var(--sans);
	}
	.build-active .done { background: var(--btn-bg); color: var(--btn-ink); }
	.remove:hover:not(:disabled), .done:hover { border-color: var(--accent); }
	.build-active kbd {
		display: inline-grid;
		place-items: center;
		min-width: 18px;
		min-height: 18px;
		padding-inline: 2px;
		border-radius: 4px;
		background: var(--surface);
		color: var(--ink);
		box-shadow: 0 1px 0 var(--edge);
		font: 900 11px/1 var(--sans);
	}
	.status {
		position: absolute; width: 1px; height: 1px; margin: -1px;
		overflow: hidden; clip-path: inset(50%); white-space: nowrap;
	}
	@media (max-width: 760px) and (min-height: 550px) {
		.build-active { top: max(134px, calc(env(safe-area-inset-top) + 54px)); }
	}
	@media (pointer: coarse) {
		.build-active kbd { display: none; }
		.close, .remove, .done { min-height: 44px; min-width: 44px; }
	}
</style>
