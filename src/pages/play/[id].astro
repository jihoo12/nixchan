---
import IslandEntry from '../../components/IslandEntry.astro';

// Keep known bookmarks useful without importing or bundling the archived games.
export function getStaticPaths() {
	return Object.keys(import.meta.glob('../../games/*/meta.ts'))
		.map((path) => path.split('/').at(-2)!)
		.filter((id) => !id.startsWith('_'))
		.map((id) => ({ params: { id } }));
}
